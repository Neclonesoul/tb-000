{
  "name": "tysonbarnes.co.uk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/prepare-sites-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && npm run test",
    "test": "vitest run",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm run build && npm run audit:content && npm run audit:links"
  },
  "dependencies": {
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@astrojs/svelte": "latest",
    "astro": "latest",
    "svelte": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "latest",
    "wrangler": "^4.0.0"
  },
  "type": "module",
  "displayName": "TB–000 / TysonBarnes.co.uk"
}
