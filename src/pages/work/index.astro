---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import ProjectExplorer from '@/components/ProjectExplorer.svelte';
import { sortProjects, toPublicProject } from '@/lib/projects';

const projects = sortProjects(await getCollection('projects')).map(toPublicProject);

const liveCount = projects.filter((project) => project.status === 'LIVE').length;
const releasedCount = projects.filter((project) => project.status === 'RELEASED').length;
const developmentCount = projects.filter((project) => project.status === 'IN DEVELOPMENT').length;
const publicCount = projects.filter((project) => project.status === 'PUBLIC').length;
---

<BaseLayout
  title="Work / Engineering Record"
  description="The Tyson Barnes engineering record: software, systems, infrastructure, field computing and public technical work."
>
  <header class="page-intro work-intro">
    <div class="shell page-intro-grid">
      <div>
        <span class="record-number">TB–000 / ENGINEERING RECORD</span>
        <h1>WORK<br />INDEX</h1>
      </div>

      <div class="work-intro-copy">
        <p>
          Systems built across physical, computational, intelligence,
          operational and observational domains. Each record preserves
          the purpose, architecture, implementation and current state
          of the work.
        </p>

        <div class="work-summary" aria-label="Portfolio summary">
          <span><strong>{projects.length}</strong> SYSTEMS</span>
          <span><strong>{liveCount}</strong> LIVE</span>
          <span><strong>{releasedCount}</strong> RELEASED</span>
          <span><strong>{developmentCount}</strong> IN DEVELOPMENT</span>
          {publicCount > 0 && <span><strong>{publicCount}</strong> PUBLIC</span>}
        </div>
      </div>
    </div>
  </header>

  <section class="work-register" aria-labelledby="complete-record-title">
    <div class="shell">
      <header class="work-register-head">
        <div>
          <span class="eyebrow">COMPLETE RECORD</span>
          <h2 id="complete-record-title">PROJECT<br />REGISTRY</h2>
        </div>

        <p>
          Stable TB identifiers form the permanent index. Status describes
          the present state of each system; links point to available evidence,
          deployments and releases.
        </p>
      </header>

      <ProjectExplorer client:load projects={projects} />
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell section-header">
      <div>
        <span class="eyebrow">SECONDARY RECORD</span>
        <h2>SELECTED<br />WEB WORK</h2>
      </div>

      <div>
        <p>
          Commercial sites and adjacent public web systems are catalogued
          separately from the principal engineering record.
        </p>
        <a class="explore-link" href="/work/selected-web-work/">
          <span>OPEN WEB RECORD</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
