---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
const notes = (await getCollection('notes')).filter((note) => !note.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Notes" description="Technical notes on software, Linux, mobile computing, field engineering and publishing.">
  <header class="page-intro"><div class="shell page-intro-grid"><div><span class="record-number">NOTES / WRITING</span><h1>TECHNICAL<br />NOTES</h1></div><p>Long-form records for decisions, methods and field-tested workflows.</p></div></header>
  <div class="shell">
    {notes.length ? <div class="archive-grid">{notes.map((note) => <a class="archive-record" href={`/notes/${note.id}/`}><span class="eyebrow">{note.data.topic}</span><div><h2>{note.data.title}</h2><p>{note.data.description}</p><span class="meta">{note.data.date.toLocaleDateString('en-GB')}</span></div></a>)}</div> : <div class="empty-state"><span class="eyebrow">ARCHIVE STATE / OPEN</span><h2>No notes have been promoted to the public archive.</h2><p>The publishing system is complete. New entries begin as plain Markdown and appear here, in RSS and in related-project navigation after passing the content schema.</p></div>}
  </div>
</BaseLayout>
