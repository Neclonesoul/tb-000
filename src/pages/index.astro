---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import { sortProjects, toPublicProject } from '@/lib/projects';
import { media } from '@/data/media';


const projects = sortProjects(await getCollection('projects')).map(toPublicProject);
const homeProjectSlugs = ['archmac', 'web', 'sa-public-api-observatory', 'veld-life'];
const selectedProjects = homeProjectSlugs.flatMap((slug) => {
  const project = projects.find((candidate) => candidate.slug === slug);
  return project ? [project] : [];
});
---

<BaseLayout>
  <!-- refresh:2026 -->
  <section class="hero hero--editorial shell">
    <div class="hero-copy">
      <div class="hero-topline">
        <span class="eyebrow">TYSON BARNES</span>
        <span class="meta">SOUTH AFRICA / UNITED KINGDOM</span>
      </div>
      <h1 aria-label="Engineering the physical and digital world">
        <span>ENGINEERING</span>
        <span class="line-2">THE PHYSICAL</span>
        <span class="line-3">&amp; DIGITAL WORLD</span>
      </h1>
      <div class="hero-bottom">
        <div>
          <p class="hero-descriptor">Engineering · Software · Systems · AI · Field Technology</p>
          <a class="explore-link" href="#selected-work">
            <span>EXPLORE THE WORK</span><span>↓</span>
          </a>
        </div>
        <p class="hero-intro">
          A permanent index of systems built, observed, documented and published—across
          industrial practice, software engineering, infrastructure, applied AI and the field.
        </p>
      </div>
    </div>
    <figure class="hero-image">
      <img src={media.hero.src} alt={media.hero.alt} fetchpriority="high" decoding="async" />
      <figcaption>PHYSICAL SYSTEMS / DIGITAL SYSTEMS / FIELD PRACTICE</figcaption>
    </figure>
  </section>

  <section class="section section--paper" id="selected-work">
    <div class="shell">
      <header class="section-header">
        <div>
          <span class="eyebrow">WORK / SELECTED SYSTEMS</span>
          <h2>BUILT<br />RECORDS</h2>
        </div>
        <p>
          An evolving record of machines, software and systems made under real constraints—from
          industrial environments and Linux workstations to public data, mobile computing and
          tools for the field.
        </p>
      </header>

      <div class="featured-work-grid">
        {selectedProjects.map((project, index) => {
          const image = media.projects[project.slug];
         if (!image) return null;
          return (
            <article class="featured-work">
              <a class="featured-work-image" href={`/work/${project.slug}/`}>
                <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <div class="featured-work-copy">
                <div class="featured-work-meta">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{project.status}</span>
                </div>
                <h3><a href={`/work/${project.slug}/`}>{project.title}</a></h3>
                <p>{project.summary}</p>
                <div class="featured-work-links">
                  <a href={`/work/${project.slug}/`}>PROJECT RECORD ↗</a>
                  {image.href && <a href={image.href}>LIVE ↗</a>}
                  {image.demoHref && <a href={image.demoHref}>DEMO ↗</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <a class="explore-link" href="/work/">
        <span>OPEN THE FULL INDEX</span><span>↗</span>
      </a>
    </div>
  </section>

  <section class="section practice-section">
    <div class="shell">
      <header class="section-header">
        <div>
          <span class="eyebrow">PRACTICE / ONE METHOD</span>
          <h2>THE THINGS<br />CONNECT</h2>
        </div>
        <p>
          Industrial automation established the method: understand the process, identify the
          interfaces, make state visible, remove unnecessary complexity, and leave a system that
          can be operated.
        </p>
      </header>

      <div class="practice-grid">
        <section>
          <span class="practice-index">01</span>
          <h3>PHYSICAL</h3>
          <p>Instrumentation · Automation · Process Control · Industrial Systems</p>
        </section>

        <section>
          <span class="practice-index">02</span>
          <h3>COMPUTATIONAL</h3>
          <p>Software Engineering · Linux · Systems Administration · Networks</p>
        </section>

        <section>
          <span class="practice-index">03</span>
          <h3>INTELLIGENCE</h3>
          <p>AI Engineering · Agentic Systems · Data Systems · Applied Automation</p>
        </section>

        <section>
          <span class="practice-index">04</span>
          <h3>OPERATIONAL</h3>
          <p>Systems Architecture · ERP · POS · Business Automation · Controls</p>
        </section>

        <section>
          <span class="practice-index">05</span>
          <h3>OBSERVATIONAL</h3>
          <p>Microscopy · Live Blood Analysis · Photography · Field Observation</p>
        </section>
      </div>

      <a class="explore-link" href="/systems/">
        <span>EXAMINE THE SYSTEM</span><span>↗</span>
      </a>
    </div>
  </section>

  <section class="section section--racing">
    <div class="shell">
      <header class="section-header">
        <div>
          <span class="eyebrow">FIELD / PHOTOGRAPHIC RECORD</span>
          <h2>OBSERVE<br />FIRST</h2>
        </div>
        <p>
          Machinery, interfaces, landscapes, specimens and field conditions form part of the
          engineering record. Original photography is treated as evidence, not decoration.
        </p>
      </header>
      <div class="home-field-plates">
        <figure class="home-field-plate home-field-plate--wide">
          <img src={media.field[0].src} alt={media.field[0].alt} loading="lazy" decoding="async" />
          <figcaption>{media.field[0].caption}</figcaption>
        </figure>
        <figure class="home-field-plate home-field-plate--portrait">
          <img src={media.field[1].src} alt={media.field[1].alt} loading="lazy" decoding="async" />
          <figcaption>{media.field[1].caption}</figcaption>
        </figure>
      </div>
      <a class="explore-link" href="/photography/">
        <span>OPEN PHOTOGRAPHY</span><span>↗</span>
      </a>
    </div>
  </section>

  <section class="section closing-statement">
    <div class="shell closing-grid closing-grid--portrait">
      <div class="identity-mark">
        <img src={media.portrait.src} alt={media.portrait.alt} loading="lazy" decoding="async" />
        <div>
          <span class="eyebrow">TYSON BARNES / SYSTEMS / 2026</span>
          <a href="/about/">ABOUT / PRACTICE ↗</a>
        </div>
      </div>
      <p>
        The medium changes. The method does not: understand the system, expose its state, reduce
        unnecessary complexity, and build something that can be operated.
      </p>
    </div>
  </section>
</BaseLayout>
