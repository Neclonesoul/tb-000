---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import { media } from '@/data/media';
import { sortProjects } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectMedia = media.projects[project.data.slug as keyof typeof media.projects];

const projects = sortProjects(await getCollection('projects'));

const related = projects.filter((item) =>
  project.data.relationships.some((ref) => ref.id === item.id)
);
---

<BaseLayout
  title={`${project.data.id} / ${project.data.title}`}
  description={project.data.description}
  type="article"
>
  <article class="dossier">
    <header class="dossier-hero">
      <div class="shell">
        <div class="dossier-kicker">
          <span
            class="record-number"
            transition:name={`project-id-${project.data.slug}`}
          >
            {project.data.id} / SYSTEM RECORD
          </span>

          <span class="status">{project.data.status}</span>
        </div>

        {project.data.slug === 'archmac' && (
  <figure class="archmac-machine-hero">
    <!-- ARCHMAC-MACHINE-HERO -->
    <img
      src="/media/curated/archmac-02.png"
      alt="ARCHMAC sovereign Linux workstation"
      loading="eager"
      decoding="async"
    />
  </figure>
)}

{projectMedia && (
  <figure class="system-dossier-hero">
    <!-- SYSTEM-DOSSIER-HERO -->
    <img
      src={projectMedia.src}
      alt={projectMedia.alt}
      loading="eager"
      decoding="async"
    />
    {projectMedia.caption && (
      <figcaption>{projectMedia.caption}</figcaption>
    )}
  </figure>
)}

<div class="dossier-lead">
          <div>
            <h1 transition:name={`project-title-${project.data.slug}`}>
              {project.data.title}
            </h1>

            <div class="dossier-actions">
              {
                project.data.sourceUrl &&
                <a class="text-link" href={project.data.sourceUrl}>
                  SOURCE ↗
                </a>
              }

              {
                project.data.liveUrl &&
                <a class="text-link" href={project.data.liveUrl}>
                  LIVE ↗
                </a>
              }

              {
                project.data.demoUrl &&
                <a class="text-link" href={project.data.demoUrl}>
                  DEMO ↗
                </a>
              }

              {
                project.data.releaseUrl &&
                <a class="text-link" href={project.data.releaseUrl}>
                  RELEASE ↗
                </a>
              }
            </div>
          </div>

          <p>{project.data.description}</p>
        </div>
      </div>
    </header>

    <dl class="dossier-meta shell">
      <div>
        <dt>TYPE</dt>
        <dd>{project.data.type}</dd>
      </div>

      <div>
        <dt>YEAR</dt>
        <dd>{project.data.year}</dd>
      </div>

      <div>
        <dt>STATUS</dt>
        <dd>{project.data.status}</dd>
      </div>

      <div>
        <dt>TOOLS</dt>
        <dd>
          {project.data.technologies.length
            ? project.data.technologies.join(' · ')
            : '—'}
        </dd>
      </div>
    </dl>

    <div class="dossier-body shell">
      <article>
        <Content />
      </article>

      <aside>
        <span class="eyebrow">RELATED SYSTEMS</span>

        {
          related.length ? (
            <ul class="related-list">
              {related.map((item) => (
                <li>
                  <a href={`/systems/${item.data.slug}/`}>
                    {item.data.id}<br />
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="meta">No linked record.</p>
          )
        }

        <a class="explore-link" href="/systems/">
          <span>RETURN TO SYSTEMS</span>
          <span>←</span>
        </a>
      </aside>
    </div>
  </article>
</BaseLayout>
