---
import BaseLayout from '@/components/BaseLayout.astro';
---

<BaseLayout
  title="Photography / The Observed World"
  description="Selected original photography by Tyson Barnes: places, systems, objects and observations retained as a visual record."
>
  <main class="photo-monograph">
    <header class="photo-monograph-head shell">
      <div>
        <span class="eyebrow">PHOTOGRAPHY / SELECTED PLATES</span>
        <h1>THE<br />OBSERVED<br />WORLD.</h1>
      </div>

      <div class="photo-monograph-intro">
        <p>
          Photography as a record of attention. Places, systems, objects
          and moments are retained when the image itself says something
          worth preserving.
        </p>

        <p class="meta">
          ORIGINAL PHOTOGRAPHY / CURATED COLLECTION / NO STOCK IMAGERY
        </p>
      </div>
    </header>

    <section class="photo-collection-pending shell">
      <span class="eyebrow">COLLECTION / 2026</span>

      <p>
        A new selected photographic collection is being prepared for
        publication.
      </p>
    </section>

    <nav
      class="photo-monograph-exits shell"
      aria-label="Photography related sections"
    >
      <a
        href="https://www.flickr.com/photos/tysonbarnes/"
        rel="me"
      >
        <span>FULL PHOTO ARCHIVE / FLICKR</span>
        <span>↗</span>
      </a>

      <a href="/notes/">
        <span>NOTES</span>
        <span>↗</span>
      </a>

      <a href="/about/">
        <span>ABOUT THE PRACTICE</span>
        <span>↗</span>
      </a>
    </nav>
  </main>
</BaseLayout>
